local plrsS = game:GetService("Players")
local plr = plrsS.LocalPlayer

local plrCharacter = nil
local tool = "Handheld Laser Cannon"
local started = false

local DontKillThisPlrs = {
    "testakker_2",
    "tgyurr",
    "Ratatutyrus"
}

local function FindNearestPlayer()
    local nearest
    local distance = math.huge

    local rayparams = RaycastParams.new()
    rayparams.FilterDescendantsInstances = {plr.Character}
    rayparams.FilterType = Enum.RaycastFilterType.Exclude

    for _, otherplr in ipairs(plrsS:GetPlayers()) do
        if table.find(DontKillThisPlrs, otherplr.Name) then 
            continue 
        end

        local prime = otherplr.Character and otherplr.Character.PrimaryPart
        if not prime then continue end
        if otherplr.Team == plr.Team then continue end
        
        local Pchar = plr.Character
        if not Pchar or not Pchar.PrimaryPart then continue end -- Safety check for local player
        
        local mag = (Pchar.PrimaryPart.CFrame.Position - prime.CFrame.Position).Magnitude
        if mag > distance then continue end

        local raycastResult = workspace:Raycast(
            Pchar.PrimaryPart.CFrame.Position, 
            prime.CFrame.Position - Pchar.PrimaryPart.CFrame.Position, 
            rayparams
        )

        if raycastResult and raycastResult.Instance then
            local hitModel = raycastResult.Instance:FindFirstAncestorOfClass("Model")
            local hitPlr = plrsS:GetPlayerFromCharacter(hitModel)

            if hitPlr ~= otherplr or otherplr.Character.Humanoid.Health <= 0 or otherplr.Character.Parent == nil then
                continue
            end

            distance = mag
            nearest = otherplr
        end
    end

    return nearest, distance
end


local coro

local function Loop()
coro = task.spawn(function()
    while task.wait() do
        local pplr, dist = FindNearestPlayer()
        if pplr == nil or dist == nil then continue end
        plrCharacter = pplr.Character
        if plrCharacter == nil then return end
        local X,Y,Z = plrCharacter.PrimaryPart.Position.X, plrCharacter.PrimaryPart.Position.Y, plrCharacter.PrimaryPart.Position.Z
        local args = {
            vector.create(X, Y, Z),
            true
        }
        if not plr.Character:FindFirstChild("Handheld Laser Cannon") then
            tool = "Large Laser Cannon"
        else
            tool = "Handheld Laser Cannon"
        end
        if started == false then
            if string.lower(plr.Team.Name) == "alliances / humans" then
                plr.Character:WaitForChild(tool):WaitForChild("RemoteFunction"):InvokeServer(unpack(args))
            else
                plr.Character:WaitForChild("RemoteFunction"):InvokeServer(unpack(args))
            end
            started = true
        end
        for i=100,0,-1 do
            if string.lower(plr.Team.Name) == "alliances / humans" then
                plr.Character:WaitForChild(tool):WaitForChild("RemoteEvent3"):FireServer(unpack(args))
            else
                plr.Character:WaitForChild("RemoteEvent3"):FireServer(unpack(args))
            end
        end
    end
end)
end

Loop()

game:GetService("UserInputService").InputBegan:Connect(function(input, p)
    if p then return end 
    if input.KeyCode == Enum.KeyCode.K then
        task.cancel(coro)
        started = false
        Loop()
    end
end)
