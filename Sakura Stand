local function UseMouseInput(key)
    local keys = {
        ["left"] = 0,
        ["right"] = 1,
        ["middle"] = 2,
    }

    local tolowstrkey = string.lower(key)

    if keys[tolowstrkey] then
        local KEY = tonumber(keys[tolowstrkey])
        VIM:SendMouseButtonEvent(0,0, KEY ,true,game.Players.LocalPlayer,1)
        task.wait(0.1)
        VIM:SendMouseButtonEvent(0,0, KEY ,false,game.Players.LocalPlayer,1)
    end
end

local function FindStandInStorageSlot(standName: string, countEquipped: boolean)
    local nameToId = tonumber(table.find(StandNameList, tostring(standName)))
    local currentStandId = tonumber(Data.Stand.Value)
    local foundSlotId = nil
    if countEquipped and not currentStandId == nameToId or countEquipped and currentStandId == nameToId or not countEquipped and not currentStandId == nameToId then
        for _, v in Data:GetChildren() do
            if v:IsA("IntValue") and string.find(v.Name, "Slot") then
                if v.Value == nameToId then
                    foundSlotId = tonumber(v.Name)
                end
            end
        end
    end

    return foundSlotId
end

local function StartAnubisQuest()
    if Data.Cash.Value < 1000 then return "Broke" end
