local function DirtPartch()
while task.wait(.1) do
    for i, v in workspace.Item:GetChildren() do
        if v.Name == "DirtPatch" then
            task.spawn(function()
                local char = plr.Character
                local hrp = char.HumanoidRootPart or char.PrimaryPart

                if hrp and v:FindFirstChildOfClass("ProximityPrompt") and DirtTggleVar==true then
                    local prev = hrp.Position
                    hrp.Position = v.Position + Vector3.new(0,3,0)
                    task.wait(1)
                    repeat
                    if v == nil or v.Parent ~= workspace.Item then break end
                    fireproximityprompt(v:FindFirstChildOfClass("ProximityPrompt"))
                    task.wait(.1)
                    until v == nil or DirtTggleVar == false
                    task.wait()
                end
            end)
        end
    end
end
end

