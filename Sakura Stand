local function UseKey(key, holdOrUnhold)
if holdOrUnhold == nil then
VIM:SendKeyEvent(true, key, false, game)
task.wait()
VIM:SendKeyEvent(false, key, false, game)
elseif holdOrUnhold == "Hold" then
    VIM:SendKeyEvent(true, key, false, game)
