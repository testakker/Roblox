local function FindStandInStorageSlot(standName)
    for _, v in game:GetService("Players").LocalPlayer.PlayerGui.StandStorage.Outer.Inner.Inner:GetChildren() do
        if v:IsA("ImageButton") and string.find(v.Name, "Slot") then
            local label = v.Text
            string.split(v.Name, "Slot")
            if label.Text == tostring(standName) then return true, v.Name end
        end
    end
    return false
end

