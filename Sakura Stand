local function DirtPartch()
    while task.wait(0.5) do
        if not DirtTggleVar then continue end
        
        local char = game.Players.LocalPlayer.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
        
        if itemsFolder and hrp then
            for i, v in pairs(itemsFolder:GetChildren()) do
                if not DirtTggleVar then break end 
                
                if v.Name == "DirtPatch" and v.Parent == itemsFolder then
                    local prompt = v:FindFirstChildOfClass("ProximityPrompt")
                    
                    if prompt and prompt.Enabled then
                        local previousPosition = hrp.CFrame
                        
                        hrp.CFrame = CFrame.new(v.Position + Vector3.new(0, 3, 0))
                        
                        task.wait(0.2)
                        
                        repeat
                            if not DirtTggleVar or not v or v.Parent ~= itemsFolder or not prompt.Enabled then 
                                break 
                            end
                            
                            pcall(function()
                                fireproximityprompt(prompt)
                            end)
                            
                            task.wait(0.1)
                        until not v or v.Parent ~= itemsFolder or not DirtTggleVar
                        
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end

local function autobox()
   while task.wait(0.5) do
      if (not AutoBox and not AutoChest) then continue end
      
      local char = game.Players.LocalPlayer.Character
      local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)

      if itemsFolder and hrp then
         for i, v in pairs(itemsFolder:GetChildren()) do
               if (not AutoBox and not AutoChest) then break end 

               local HASchestKey = function()
                     if game.Players.LocalPlayer.Backpack:FindFirstChild("Chest Key") or char:FindFirstChild("Chest Key") then print("Key!"); return true end 
                     return false
               end

               if HASchestKey == true and AutoChest then
                  if v.Name == "Chest" then
                    print("Key!");
                        pcall(function()
                            hrp.CFrame = CFrame.new(v.Position + Vector3.new(1, 0, 0))
                            v.ProximityPrompt.HoldDuration = 0; 
                            task.wait(0.3); 
                            fireproximityprompt(v.ProximityPrompt); 
                            task.wait(0.1) 
                        end)
                  end
               end

               if v.Name == "Box" and v.Parent == itemsFolder and AutoBox then
                    pcall(function()
                        local prompt = v:FindFirstChildOfClass("ProximityPrompt")
                        hrp.CFrame = CFrame.new(v.Position + Vector3.new(1, 0, 0))
                        prompt.HoldDuration = 0; 
                        task.wait(0.3); 
                        fireproximityprompt(prompt); 
                        task.wait(0.1) 
                    end)
               end
            end
        end

   end
end

