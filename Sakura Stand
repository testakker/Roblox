local targetRenderSteppedFunc = nil 
local lastAppliedCooldown = nil
local function getJumpFunctionSafe()
    if targetRenderSteppedFunc then 
        return targetRenderSteppedFunc 
    end
    
    for _, f in pairs(getgc()) do
        if type(f) == "function" and islclosure(f) then
            local source = debug.info(f, "s")
            if source and string.find(source, "JumpCooldown") then
                local upvalues = debug.getupvalues(f)
                if #upvalues >= 4 then
                    targetRenderSteppedFunc = f
                    return f
                end
            end
        end
    end
    return nil
end

local function JumpCdfunc()
    while task.wait(.1) do
        local char, humanoid, hrp, head, torso = FindMyPlayerCharacter()

        if not char or not humanoid or humanoid.Health <= 0 then
            targetRenderSteppedFunc = nil 
            lastAppliedCooldown = nil
            continue 
        end
        
        if JumpEnabled then
            if lastAppliedCooldown ~= JumpCooldown then
                local f = getJumpFunctionSafe()
                if f then
                    debug.setupvalue(f, 4, JumpCooldown)
                    lastAppliedCooldown = JumpCooldown
                end
            end
        else
            if lastAppliedCooldown ~= 0.5 then
                local f = getJumpFunctionSafe()
                if f then
                    debug.setupvalue(f, 4, 0.5)
                    lastAppliedCooldown = 0.5
                end
            end
        end
    end
end

